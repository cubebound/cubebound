# Supabase (Project Settings -> API)
# The project URL is the bare origin — no /rest/v1 path. A path here makes every
# supabase-js call 404 with PGRST125.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The PUBLISHABLE key (sb_publishable_… , or the legacy anon JWT). NEXT_PUBLIC_
# values are inlined into the browser bundle, so never put an sb_secret_… /
# service_role key here — it bypasses Row Level Security. The app refuses to
# start if it detects one.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key

# Public origin used to build magic-link redirects. Set this in production so
# links point at the real domain instead of a preview deployment.
# NEXT_PUBLIC_SITE_URL=https://cubebound.gg

# Postgres connection string for Drizzle (Supabase: Project Settings -> Database).
# Use the transaction pooler URL (port 6543) for the app; the direct connection
# (port 5432) also works for migrations and the sync script.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres

# Card sync source: riftscribe (default) | riot.
# The riot adapter is dormant until our riftbound-content-v1 application is
# approved (the endpoint 403s on dev keys).
CARD_SOURCE=riftscribe
# RIFTSCRIBE_BASE_URL=https://riftscribe.gg

# Riot API (https://developer.riotgames.com). Only needed when CARD_SOURCE=riot.
# RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Regional route for the content endpoint: americas | asia | europe
# RIOT_API_REGION=americas
