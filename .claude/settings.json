{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(npm run check:*)",
      "Bash(npm run stats)",
      "Bash(npm run stats *)",
      "Bash(npm run prod-read *)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Agent(data)"
    ]
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Spawning the `data` subagent is allowed. It reads production only through `npm run stats -- --prod` and `npm run prod-read`, which connect as a Postgres role granted SELECT and nothing else, so it cannot write to production."
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "out=$(node_modules/.bin/tsc --noEmit 2>&1) || printf '%s' \"$out\" | node -e \"let d='';process.stdin.on('data',c=>d+=c).on('end',()=>console.log(JSON.stringify({systemMessage:'tsc failed — '+d.slice(0,400)})))\"",
            "timeout": 60,
            "statusMessage": "Typechecking"
          }
        ]
      }
    ]
  }
}
